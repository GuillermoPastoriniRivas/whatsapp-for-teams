# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/hivvo?retryWrites=true&w=majority

# JWT
JWT_SECRET=generate-a-strong-secret-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=generate-another-strong-secret
JWT_REFRESH_EXPIRES_IN=30d

# Meta Cloud API
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# App
PORT=3000
FRONTEND_URL=https://asis.chat

# Platform AI (single provider/model/key for ALL tenant bots)
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
AI_API_KEY=sk-ant-...

# Base de conocimiento — los embeddings son de OpenAI, asi que va una clave de
# OpenAI aunque AI_PROVIDER sea anthropic. Sin esto, indexar un documento falla.
AI_EMBEDDINGS_API_KEY=sk-...
# AI_EMBEDDINGS_MODEL=text-embedding-3-small

# AWS SES (uses IAM instance role on EC2 — no keys needed)
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=no-reply@asis.chat
SES_REPLY_TO_EMAIL=contact@asis.chat

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-email@dominio.com

# Flujos — cifrado de secretos de Conexiones (ver .env.example)
FLOW_SECRETS_KEY=

# API publica de desarrolladores — limite de requests por clave por minuto (default: 120)
# PUBLIC_API_RATE_LIMIT=120
