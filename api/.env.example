# MongoDB
MONGODB_URI=mongodb://localhost:27017/whatsapp-teams

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Meta Cloud API
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# App
PORT=3000
FRONTEND_URL=http://localhost:3001

# Platform AI (single provider/model/key for ALL tenant bots)
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
AI_API_KEY=sk-ant-...

# AWS SES (optional — falls back to IAM role if omitted)
# AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@asis.chat
SES_REPLY_TO_EMAIL=contact@asis.chat

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-email@dominio.com

# Flujos — cifrado (AES-256-GCM) de los secretos de las Conexiones del nodo HTTP.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde/rota, las Conexiones ya guardadas dejan de poder descifrarse.
FLOW_SECRETS_KEY=

# API publica de desarrolladores — limite de requests por clave por minuto (default: 120)
# PUBLIC_API_RATE_LIMIT=120

# ─── Media library ────────────────────────────────────────────────
# Sin ninguna de las dos variables de storage, TODA la instalación opera en
# passthrough: los archivos viven 30 días en Meta y después se pierden. La
# biblioteca (planes pagos) necesita storage configurado.

# Producción: bucket S3 privado. El EC2 lo accede con su rol IAM.
# MEDIA_S3_BUCKET=asis-chat-media
# MEDIA_S3_REGION=us-east-1

# Desarrollo: disco local. No definir las dos a la vez (gana S3).
# MEDIA_LOCAL_PATH=./.media-storage

# Base pública de la API — se usa para armar las URLs de los archivos.
# API_PUBLIC_URL=https://asis.chat

# Dominio desde el que se sirve contenido subido por terceros. Idealmente
# distinto al de la app: un SVG servido desde asis.chat sería XSS almacenado.
# MEDIA_PUBLIC_BASE_URL=https://media.asis.chat

# Firma de las URLs del proxy de media. Si no se define usa JWT_SECRET.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MEDIA_URL_SECRET=

# Vida de una URL de lectura, en segundos (default: 900 = 15 min)
# MEDIA_URL_TTL_SECONDS=900

# Cuánto puede cachear el navegador un archivo ya bajado (default: 86400 = 1 día).
# Bajarlo mucho hace que cada scroll de la bandeja vuelva a pegarle a Meta.
# MEDIA_BROWSER_CACHE_SECONDS=86400
